---
import Header from "../../../components/Header.astro";
import Footer from "../../../components/Footer.astro";
import { getSiteConfig } from "../../../i18n";
import "../../../styles/global.css";

const siteConfig = getSiteConfig(Astro.url.pathname);
const accent = siteConfig.accentColor;
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href="https://www.apostolis.dev/el/projects/eukairon/" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta
      name="description"
      content="Eukairon — Multi-tenant SaaS πλατφόρμα κρατήσεων, χτισμένη με Laravel, React, MySQL & Docker."
    />
    <meta name="author" content={siteConfig.name} />
    <meta property="og:type" content="article" />
    <meta property="og:title" content="Eukairon — Case Study | Αποστόλης Συριώδης" />
    <meta
      property="og:description"
      content="Πώς έφτιαξα μια multi-tenant SaaS πλατφόρμα κρατήσεων με Laravel, React, MySQL & Docker."
    />
    <meta property="og:image" content="https://www.apostolis.dev/eukairon-banner-el.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Eukairon — Case Study | {siteConfig.name}</title>
  </head>
  <body>
    <Header />

    <main class="pt-32 pb-24">
      <!-- HERO -->
      <section class="px-6 sm:px-12 md:px-24 pb-16">
        <div class="max-w-6xl mx-auto">
          <a
            href="/el/"
            class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors mb-8"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Πίσω στο portfolio
          </a>

          <div class="grid grid-cols-1 lg:grid-cols-3 gap-12 items-center">
            <div class="lg:col-span-2">
              <div class="flex items-center gap-3 mb-4">
                <span class="text-xs font-semibold px-3 py-1 rounded-full" style={`background-color: ${accent}20; color: ${accent}`}>
                  FLAGSHIP PROJECT
                </span>
                <span class="text-xs font-medium text-amber-700 bg-amber-100 px-3 py-1 rounded-full">
                  Έρχεται σύντομα
                </span>
              </div>
              <h1 class="text-5xl sm:text-6xl md:text-7xl font-bold text-gray-900 mb-6 leading-tight">
                Eukairon
              </h1>
              <p class="text-xl sm:text-2xl text-gray-600 leading-relaxed mb-8">
                Multi-tenant SaaS πλατφόρμα κρατήσεων για μικρές επιχειρήσεις — κομμωτήρια, συνεργεία, κτηνιατρεία. Χτισμένη με Laravel, Inertia.js + React, MySQL, Redis & Docker.
              </p>
              <div class="flex flex-wrap gap-2">
                {["Laravel", "React.js", "Inertia.js", "MySQL", "Redis", "Docker", "Stripe", "Pest", "Playwright"].map((tech) => (
                  <span class="px-3 py-1.5 bg-gray-900 text-white text-sm font-medium rounded-lg">{tech}</span>
                ))}
              </div>
            </div>
            <div class="lg:col-span-1">
              <div class="rounded-2xl overflow-hidden shadow-2xl" style={`border: 4px solid ${accent};`}>
                <img src="/eukairon-landing-el.png" alt="Eukairon — αρχική σελίδα" class="w-full h-auto" />
              </div>
            </div>
          </div>
        </div>
      </section>

      <!-- OVERVIEW -->
      <section class="px-6 sm:px-12 md:px-24 py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">Επισκόπηση</h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
            <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
              <p>
                Το <strong class="text-gray-900">Eukairon</strong> επιτρέπει σε μικρές επιχειρήσεις να δέχονται κρατήσεις 24/7 — χωρίς τηλέφωνα, χωρίς χαμένα ραντεβού. Κάθε επιχείρηση (workspace) έχει τους δικούς της επαγγελματίες, υπηρεσίες, ωράριο, πελάτες και κρατήσεις, με πλήρη απομόνωση δεδομένων μεταξύ tenants.
              </p>
              <p>
                Οι πελάτες κλείνουν ραντεβού από τη δημόσια σελίδα κρατήσεων της επιχείρησης — χωρίς λογαριασμό — και λαμβάνουν SMS υπενθύμιση πριν το ραντεβού. Οι ιδιοκτήτες διαχειρίζονται τα πάντα από ένα dashboard: live ημερολόγιο, υπηρεσίες, επαγγελματίες, ωράρια και εξαιρέσεις, καθώς και τη συνδρομή τους μέσω Stripe. Πλήρως δίγλωσσο (ελληνικά / αγγλικά), με τη ζώνη ώρας κάθε επιχείρησης και την αλλαγή ώρας να υπολογίζονται στον server.
              </p>
            </div>
            <div class="rounded-2xl overflow-hidden shadow-xl self-center">
              <img src="/eukairon-banner-el.png" alt="Eukairon — Πλατφόρμα Κρατήσεων SaaS" class="w-full h-auto" />
            </div>
          </div>
        </div>
      </section>

      <!-- KEY FEATURES -->
      <section class="px-6 sm:px-12 md:px-24 py-16">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">Βασικά Χαρακτηριστικά</h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            {[
              { title: "Multi-tenant & Role-based Access", desc: "Απομόνωση δεδομένων σε middleware, request authorization, route binding, και ρητό φίλτρο workspace σε κάθε query. Ρόλοι owner, admin, member και viewer ανά workspace." },
              { title: "Real-time Booking Engine", desc: "Οι πελάτες επιλέγουν υπηρεσία, επαγγελματία, ημερομηνία και ώρα από live διαθεσιμότητα. Conflict detection, άρνηση παρελθοντικών slots, και ενημέρωση ημερολογίου μέσω WebSockets (Reverb)." },
              { title: "Αυτόματες Υπενθυμίσεις", desc: "SMS υπενθυμίσεις σε Redis queue, 24 ώρες και 2 ώρες πριν από κάθε ραντεβού, η καθεμία με link ακύρωσης ενός κλικ." },
              { title: "Stripe Billing", desc: "Πλάνα Solo / Pro / Business με σταθερή τιμή, 30 ημέρες δοκιμή στο Solo χωρίς κάρτα, ΦΠΑ στο checkout, και admin plan override για ειδικές περιπτώσεις." },
              { title: "REST API", desc: "Versioned API με scoped read/write keys, rate limiting ανά key και plan gating — η επιχείρηση στέλνει κρατήσεις από τα δικά της συστήματα." },
              { title: "Automated Tests", desc: "3.200+ Pest tests (feature + Playwright browser) και 1.100+ Vitest tests, που τρέχουν παράλληλα ως merge gate. Κάθε security fix αποδεικνύεται πρώτα ότι αποτυγχάνει στον χαλασμένο κώδικα." },
            ].map((f) => (
              <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 hover:shadow-md transition-shadow">
                <h3 class="text-lg font-bold text-gray-900 mb-2">{f.title}</h3>
                <p class="text-gray-600 text-sm leading-relaxed">{f.desc}</p>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- TECHNICAL CHALLENGES -->
      <section class="px-6 sm:px-12 md:px-24 py-16 bg-gray-50">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">Τεχνικές Προκλήσεις</h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <div class="space-y-8">
            {[
              { num: "01", title: "Tenant isolation σε κάθε layer", desc: "Δεν αρκεί ένα where('workspace_id', ...) — η απομόνωση έπρεπε να ελεγχθεί σε middleware, FormRequest authorize(), controller writes, route model binding, και queue jobs. Ένα dangling pointer στο current_workspace_id (owner removed από workspace) άνοιγε access. Λύθηκε με defense-in-depth: scopeBindings(), role gates, plan gates, και feature flags — κάθε layer αρνείται ανεξάρτητα." },
              { num: "02", title: "Refusal shape consistency (403 vs 404)", desc: "Κάποια endpoints απαντούσαν 403 για workspace στο οποίο ο χρήστης δεν ανήκει — επιβεβαιώνοντας ότι το workspace υπάρχει — ενώ τα siblings έδιναν 404. Αυτή η διαφορά είναι enumeration oracle. Ομαλοποιήθηκε σε 404 για κάθε ξένο workspace, με tests που pin-άρουν το shape route προς route." },
              { num: "03", title: "Stripe integration με plan override", desc: "Πέρα από τα standard Stripe subscriptions, υπάρχει admin plan_override feature για δωρεάν Pro/Business. Ο plan gate διαβάζει από μία authoritative πηγή (config/billing.php) — όχι hardcoded strings. Η πρόσβαση στο API ελέγχεται πάνω στο ίδιο το credential, άρα τα keys ενός downgraded workspace σταματούν να δουλεύουν τη στιγμή που αλλάζει το plan." },
              { num: "04", title: "Ώρες κρατήσεων σε ζώνες ώρας", desc: "Η εφαρμογή τρέχει σε UTC, ενώ κάθε κράτηση είναι τοπική ώρα στη ζώνη ώρας της επιχείρησης. Το booking engine (laraveljutsu/zap) σύγκρινε date strings, οπότε ένα slot της χθεσινής μέρας της επιχείρησης περνούσε για περίπου τρεις ώρες τη μέρα, και ένα timestamp με offset που αποθηκευόταν χωρίς ->utc() κατέληγε ώρες λάθος. Λύθηκε με σύγκριση instants, άρνηση παρελθοντικής ώρας σε κάθε write path (admin, API, public), υποχρεωτικό offset στο API, και φιλτράρισμα της λίστας slots σε ένα σημείο, ώστε καμία οθόνη να μην προσφέρει slot που μια άλλη αρνείται." },
              { num: "05", title: "Queue observability & data leaks", desc: "Τα notifications ήταν sync — κάθε email έμπαινε inline στο request. Μετακίνηση σε queue βελτίωσε latency αλλά δημιούργησε νέο πρόβλημα: αν ο worker πέσει, τα delivery logs δεν γράφονται, και historical rows με comment content διέρρεαν μέσω notification read paths μετά από feature retirement. Λύθηκε με centralized visibility (User::visibleNotifications()) που καλείται από όλα τα read paths + export job." },
              { num: "06", title: "Test infrastructure robustness", desc: "phpunit.xml <env> entries ήταν inert — container .env υπερίσχυε, άρα tests push-άραν real jobs στο dev Redis (271K failed_jobs). Baseline drift 4 φορές από manual bumps. Λύθηκε με executable baseline (baseline.json, ανοχή ±5) που ελέγχεται σε κάθε merge, locks ανά βάση ώστε παράλληλα sessions να μη μοιράζονται ποτέ test DB, και parallel gate 4 processes που τρέχει όλη τη σουίτα σε περίπου ένα λεπτό." },
            ].map((c) => (
              <div class="bg-white rounded-xl border border-gray-100 shadow-sm p-6 sm:p-8 hover:shadow-md transition-shadow">
                <div class="flex items-start gap-6">
                  <span class="text-2xl sm:text-3xl font-bold font-mono flex-shrink-0" style={`color: ${accent}`}>{c.num}</span>
                  <div>
                    <h3 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">{c.title}</h3>
                    <p class="text-gray-600 leading-relaxed">{c.desc}</p>
                  </div>
                </div>
              </div>
            ))}
          </div>
        </div>
      </section>

      <!-- ADMIN SHOWCASE -->
      <section class="px-6 sm:px-12 md:px-24 py-16">
        <div class="max-w-6xl mx-auto">
          <div class="mb-12">
            <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">Dashboard Ιδιοκτήτη</h2>
            <div class="w-[75px] h-[5px] mt-2 rounded-full" style={`background-color: ${accent}`} />
          </div>
          <div class="grid grid-cols-1 md:grid-cols-2 gap-12 items-center">
            <div class="rounded-2xl overflow-hidden shadow-xl">
              <img src="/eukairon-dashboard-el.png" alt="Eukairon — dashboard ιδιοκτήτη" class="w-full h-auto" />
            </div>
            <div class="space-y-6 text-lg text-gray-600 leading-relaxed">
              <p>
                Ό,τι χρειάζεται ο ιδιοκτήτης με μια ματιά: έσοδα, κρατήσεις μήνα, πληρότητα και ποσοστό μη εμφανίσεων σε σχέση με τον προηγούμενο μήνα, το σημερινό και το επόμενο πρόγραμμα, κορυφαίοι πελάτες, και έσοδα ανά ημέρα. Κάθε workspace βλέπει μόνο τα δικά του δεδομένα.
              </p>
              <ul class="space-y-3">
                {["KPIs σε σύγκριση με τον προηγούμενο μήνα", "Σημερινό & επόμενο πρόγραμμα", "Κορυφαίοι πελάτες & έσοδα ανά ημέρα", "Νέα κράτηση με ένα κλικ"].map((item) => (
                  <li class="flex items-start gap-3">
                    <span class="inline-block w-2 h-2 rounded-full mt-2.5 flex-shrink-0" style={`background-color: ${accent}`} />
                    <span>{item}</span>
                  </li>
                ))}
              </ul>
            </div>
          </div>
        </div>
      </section>

      <!-- CTA -->
      <section class="px-6 sm:px-12 md:px-24 py-16">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900 mb-6">Χρειάζεστε κάτι παρόμοιο;</h2>
          <p class="text-xl text-gray-600 mb-10">
            Χτίζω multi-tenant SaaS πλατφόρμες, REST APIs, και πολύπλοκες ενσωματώσεις από το μηδέν. Ας μιλήσουμε για το project σας.
          </p>
          <a href="/el/#contact" class="inline-flex items-center gap-2 px-8 py-4 text-white font-medium rounded-lg transition hover:opacity-90" style={`background-color: ${accent}`}>
            Επικοινωνία
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7" />
            </svg>
          </a>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>