---
import Header from "../../components/Header.astro";
import Footer from "../../components/Footer.astro";
import { getSiteConfig } from "../../i18n";
import "../../styles/global.css";

const siteConfig = getSiteConfig(Astro.url.pathname);
const ui = siteConfig.ui;
const accent = siteConfig.accentColor;
---

<html lang="el">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content="Πολιτική Απορρήτου για το apostolis.dev" />
    <meta name="robots" content="noindex" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:ital,wght@0,100;0,200;0,300;0,400;0,500;0,600;0,700;1,100;1,200;1,300;1,400;1,500;1,600;1,700&display=swap"
      rel="stylesheet"
    />
    <title>Πολιτική Απορρήτου | {siteConfig.name}</title>
  </head>
  <body>
    <Header />

    <main class="pt-32 pb-24">
      <section class="px-6 sm:px-12 md:px-24">
        <div class="max-w-3xl mx-auto">
          <a
            href="/el/"
            class="inline-flex items-center gap-2 text-sm text-gray-600 hover:text-gray-900 transition-colors mb-8"
          >
            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M19 12H5M12 19l-7-7 7-7" />
            </svg>
            Πίσω στο portfolio
          </a>

          <h1 class="text-4xl sm:text-5xl md:text-6xl font-bold text-gray-900 mb-4">
            {ui.privacyTitle}
          </h1>
          <div class="w-[75px] h-[5px] mb-6 rounded-full" style={`background-color: ${accent}`} />
          <p class="text-sm text-gray-500 mb-12">
            {ui.privacyLastUpdate}
          </p>

          <p class="text-lg text-gray-700 leading-relaxed mb-12">
            {ui.privacyIntro}
          </p>

          <div class="space-y-10">
            {ui.privacySections.map((section) => (
              <div>
                <h2 class="text-xl sm:text-2xl font-bold text-gray-900 mb-3">
                  {section.title}
                </h2>
                <p class="text-gray-600 leading-relaxed">
                  {section.body}
                </p>
              </div>
            ))}
          </div>
        </div>
      </section>
    </main>

    <Footer />
  </body>
</html>