---
import { getSiteConfig } from "../i18n";
const siteConfig = getSiteConfig(Astro.url.pathname);
const ui = siteConfig.ui;
---

<section
  id="contact"
  class="py-24 px-6 sm:px-12 md:px-24 bg-gray-50"
  style={`--accent-color: ${siteConfig.accentColor}`}
>
  <div class="max-w-3xl mx-auto">
    <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-800 mb-4">
      {ui.sections.contact}
    </h2>
    <p class="text-lg text-gray-600 mb-12">
      {ui.contact.intro}
    </p>

    <form id="contact-form" class="space-y-6" novalidate>
      <div>
        <label for="name" class="block text-sm font-medium text-gray-700 mb-2">
          {ui.contact.name}
        </label>
        <input
          type="text"
          id="name"
          name="name"
          required
          maxlength="100"
          autocomplete="name"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--accent-color)] focus:border-transparent outline-none transition"
          placeholder={ui.contact.namePlaceholder}
        />
      </div>

      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-2">
          {ui.contact.email}
        </label>
        <input
          type="email"
          id="email"
          name="email"
          required
          maxlength="254"
          autocomplete="email"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--accent-color)] focus:border-transparent outline-none transition"
          placeholder={ui.contact.emailPlaceholder}
        />
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-gray-700 mb-2">
          {ui.contact.message}
        </label>
        <textarea
          id="message"
          name="message"
          required
          maxlength="5000"
          rows="6"
          class="w-full px-4 py-3 border border-gray-300 rounded-lg focus:ring-2 focus:ring-[var(--accent-color)] focus:border-transparent outline-none transition resize-y"
          placeholder={ui.contact.messagePlaceholder}
        ></textarea>
      </div>

      <!-- Honeypot: hidden from people, filled in by most spam bots. -->
      <div class="hidden" aria-hidden="true">
        <label for="website">Website</label>
        <input type="text" id="website" name="website" tabindex="-1" autocomplete="off" />
      </div>

      <div id="form-status" class="hidden" role="status" aria-live="polite"></div>

      <button
        type="submit"
        id="submit-btn"
        class="w-full sm:w-auto px-8 py-3 text-white font-medium rounded-lg transition hover:opacity-90 disabled:opacity-50 disabled:cursor-not-allowed"
        style={`background-color: ${siteConfig.accentColor}`}
        data-send-label={ui.contact.send}
        data-sending-label={ui.contact.sending}
        data-success-msg={ui.contact.success}
        data-error-generic={ui.contact.errorGeneric}
        data-error-required={ui.contact.errorRequired}
        data-error-invalid-email={ui.contact.errorInvalidEmail}
      >
        {ui.contact.send}
      </button>
    </form>
  </div>
</section>

<script>
  const form = document.getElementById("contact-form") as HTMLFormElement;
  const status = document.getElementById("form-status") as HTMLDivElement;
  const submitBtn = document.getElementById("submit-btn") as HTMLButtonElement;

  const sendLabel = submitBtn.dataset.sendLabel || "Send message";
  const sendingLabel = submitBtn.dataset.sendingLabel || "Sending...";
  const successMsg = submitBtn.dataset.successMsg || "Message sent!";
  const errorGeneric = submitBtn.dataset.errorGeneric || "Something went wrong.";
  const errorRequired = submitBtn.dataset.errorRequired || errorGeneric;
  const errorInvalidEmail = submitBtn.dataset.errorInvalidEmail || errorGeneric;

  const showStatus = (kind: "success" | "error", text: string) => {
    status.className =
      kind === "success"
        ? "p-4 rounded-lg bg-green-100 text-green-800 border border-green-300"
        : "p-4 rounded-lg bg-red-100 text-red-800 border border-red-300";
    status.textContent = text;
  };

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();

    const formData = new FormData(form);
    const name = String(formData.get("name") ?? "").trim();
    const email = String(formData.get("email") ?? "").trim();
    const message = String(formData.get("message") ?? "").trim();

    // Validate here so the visitor gets the message in the page's language;
    // the API repeats these checks but answers in English.
    if (!name || !email || !message) {
      showStatus("error", errorRequired);
      return;
    }
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) {
      showStatus("error", errorInvalidEmail);
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = sendingLabel;
    status.classList.add("hidden");

    try {
      const res = await fetch("/api/contact", {
        method: "POST",
        body: formData,
      });
      const data = await res.json().catch(() => ({}));

      if (res.ok && data.success) {
        showStatus("success", successMsg);
        form.reset();
      } else {
        showStatus("error", errorGeneric);
      }
    } catch {
      showStatus("error", errorGeneric);
    } finally {
      submitBtn.disabled = false;
      submitBtn.textContent = sendLabel;
    }
  });
</script>