---
import { getSiteConfig } from "../i18n";
const siteConfig = getSiteConfig(Astro.url.pathname);
import { getSiteConfig } from "../i18n";
const hasCertifications =
  siteConfig.certifications && siteConfig.certifications.length > 0;
---

{
  hasCertifications && (
    <section id="certifications" class="p-8 sm:p-12 md:p-16 lg:p-24 bg-gray-50">
      <div class="max-w-6xl mx-auto">
        <div class="mb-12">
          <h2 class="text-3xl sm:text-4xl md:text-5xl font-bold text-gray-900">
            {siteConfig.ui.sections.certifications}
          </h2>
          <div
            class="w-[75px] h-[5px] mt-2 rounded-full"
            style={`background-color: ${siteConfig.accentColor}`}
          />
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {siteConfig.certifications.map((cert) => (
            <div class="bg-white rounded-lg shadow-sm border border-gray-100 p-4 sm:p-5 hover:shadow-md transition-shadow duration-300">
              <h3 class="text-base sm:text-lg font-semibold text-gray-900 mb-1">
                {cert.name}
              </h3>
              <p
                class="text-sm font-medium mb-2"
                style={`color: ${siteConfig.accentColor}`}
              >
                {cert.issuer} · {cert.date}
              </p>
              <div class="flex flex-wrap gap-1.5 mt-3">
                {cert.skills.map((skill) => (
                  <span class="text-xs px-2 py-1 bg-gray-100 text-gray-700 rounded-md">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  )
}